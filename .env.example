PORT=4000
DATABASE_URL=postgres://champions:champions@localhost:5432/champions
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 공급자 장애 시 다음 항목으로 넘어갑니다. rule은 외부 서비스 없이 동작합니다.
GENERATION_PROVIDERS=openai,openrouter,ollama,rule
GENERATION_PROVIDER_TIMEOUT_MS=180000
GENERATION_MAX_ATTEMPTS=4
GENERATION_RETRY_BASE_MINUTES=15
GENERATION_RETRY_MAX_MINUTES=360
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GENERATION_DAILY_HOUR_KST=0
GENERATION_DAILY_MINUTE_KST=5
# 0=일요일, 1=월요일, ... 6=토요일
GENERATION_MEDIUM_WEEKDAYS_KST=1,3,5
GENERATION_ELITE_WEEKDAYS_KST=0
# 전용 실행 노드의 비공개 HTTPS 주소입니다. 메인 백엔드 호스트에서 샌드박스를 실행하지 않습니다.
SANDBOX_SERVICE_URL=https://sandbox.internal.example.com
SANDBOX_SERVICE_TOKEN=replace-with-a-random-internal-token
WEB_ORIGIN=http://localhost:3000
