PORT=4000
DATABASE_URL=postgres://champions:champions@localhost:5432/champions
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 공급자 장애 시 다음 항목으로 넘어갑니다. rule은 외부 서비스 없이 동작합니다.
GENERATION_PROVIDERS=openai,openrouter,ollama,rule
GENERATION_PROVIDER_TIMEOUT_MS=90000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GENERATION_DAILY_HOUR_KST=0
GENERATION_DAILY_MINUTE_KST=5
# 0=일요일, 1=월요일, ... 6=토요일
GENERATION_MEDIUM_WEEKDAYS_KST=1,3,5
GENERATION_ELITE_WEEKDAYS_KST=0
SANDBOX_SERVICE_URL=http://localhost:4100
SANDBOX_SERVICE_TOKEN=replace-with-a-random-internal-token
JUDGE_IMAGE_PREFIX=algorithm-champions/judge
WEB_ORIGIN=http://localhost:3000
