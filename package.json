{
    "name": "algorithm-champions-back",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
        "build": "tsup",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
        "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
        "worker:judge": "tsx --env-file-if-exists=.env src/workers/judge/index.ts",
        "worker:generation": "tsx --env-file-if-exists=.env src/workers/generation/index.ts",
        "worker:generation:batch": "tsx --env-file-if-exists=.env src/workers/generation/generate-grade-batch.ts",
        "worker:policy": "tsx --env-file-if-exists=.env src/workers/policy/index.ts"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@fastify/cors": "^11.1.0",
        "dayjs": "^1.11.21",
        "drizzle-orm": "^0.45.2",
        "fastify": "^5.6.2",
        "ioredis": "^6.0.0",
        "jose": "^6.2.8",
        "openai": "^7.4.0",
        "pg": "^8.23.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@types/pg": "^8.21.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    }
}
