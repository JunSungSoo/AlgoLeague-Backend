# 전용 실행 노드 전용 설정. DB/Redis/AI 자격증명을 추가하지 마세요.
SANDBOX_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Linux: stat -c '%g' /var/run/docker.sock
# macOS Docker Desktop: stat -f '%g' /var/run/docker.sock
DOCKER_GID=0
# 기본값 127.0.0.1. 비공개 네트워크 또는 TLS 프록시를 통해서만 노출하세요.
SANDBOX_BIND_ADDRESS=127.0.0.1
